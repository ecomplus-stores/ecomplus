<%
/*
 * Landing page de página única com o bloco de produto padrão do storefront.
 * Conteúdo editável em `content/landing.json`. O botão de comprar adiciona o
 * plano ao carrinho e redireciona para /app/#/checkout
 * (ver template/js/custom-js/pages.js).
 */
const landing = _.cms('landing') || {}
const contacts = _.cms('contacts') || {}
const hero = landing.hero || {}
const proof = landing.proof || {}
const ai = landing.ai || {}
const chatData = landing.chat_data || {}
const chatVisual = landing.chat_visual || {}
const diagram = ai.diagram || {}
const spin = landing.spin || {}
const comparison = landing.comparison || {}
const benefits = landing.benefits || {}
const steps = landing.steps || {}
const checkout = landing.checkout || {}
const faq = landing.faq || {}
const footer = landing.footer || {}
const whatsapp = (contacts.whatsapp || '').replace(/\D/g, '')

// produto (plano) vendido na página, carregado da Store API na renderização
let product = null
if (landing.product_id) {
  try {
    const { data } = await _.ecomClient.store({
      url: `/products/${landing.product_id}.json`,
      axiosConfig: { timeout: 10000 }
    })
    product = data
  } catch (err) {
    console.error(`[landing] falha ao carregar o produto ${landing.product_id}`, err.message)
  }
}
%>

<!doctype html>
<html lang="<%= _.lang.replace('_', '-') %>" dir="ltr">

<head>
  <%- await include('@/head') %>
  <%# fontes de título da identidade e-com.plus (Urbanist vem de settings.font_family) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Sans+Extra+Condensed:ital,wght@1,500&family=Fira+Sans:ital,wght@1,500&display=swap">
</head>

<body
  id="page-home"
  class="lp"
  <% if (product) { %>
    data-resource="products"
    data-resource-id="<%= product._id %>"
  <% } %>
>
  <%# elemento exigido pelo bundle do storefront (lib/overlay.js) %>
  <div id="overlay" class="fade"></div>

  <header class="lp__hero">
    <div class="container">
      <div class="lp__brand">
        <a href="/" aria-label="<%= _.settings.name || _.store.name %>">
          <%- await include('@/layout/inc/logo-white') %>
        </a>
        <span class="lp__safe">
          <i class="i-shield"></i>
          <%= _.dictionary('safeEnvMsg') %>
        </span>
      </div>

      <div class="lp__hero-content">
        <% if (hero.badge) { %>
          <span class="lp__badge"><%= hero.badge %></span>
        <% } %>
        <h1 class="lp__title"><%= hero.title || _.settings.name %></h1>
        <% if (hero.subtitle) { %>
          <p class="lp__subtitle"><%= hero.subtitle %></p>
        <% } %>
        <a
          href="#assinar"
          class="lp__btn lp__btn--contrast lp__btn--lg"
          data-scroll-to="assinar"
        >
          <%= hero.cta || 'Assinar agora' %>
          <i class="i-chevron-down ml-1"></i>
        </a>
        <% if (hero.note) { %>
          <p class="lp__note"><%= hero.note %></p>
        <% } %>
      </div>
    </div>
  </header>

  <main id="main">
    <% if (Array.isArray(proof.items) && proof.items.length) { %>
      <section class="lp__proof">
        <div class="container">
          <div class="row">
            <% proof.items.forEach(item => { %>
              <div class="col-6 col-lg-3 mb-3 mb-lg-0">
                <div class="lp__proof-item">
                  <strong><%= item.title %></strong>
                  <span><%= item.text %></span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (Array.isArray(ai.features) && ai.features.length) { %>
      <section class="lp__section lp__ai">
        <div class="container">
          <% if (ai.title) { %>
            <h2 class="lp__section-title"><%= ai.title %></h2>
          <% } %>
          <% if (ai.subtitle) { %>
            <p class="lp__section-subtitle"><%= ai.subtitle %></p>
          <% } %>

          <div class="lp__diagram" role="img" aria-label="Agente de IA conectado por MCP à API da e-com.plus">
            <div class="lp__diagram-node lp__diagram-node--agent">
              <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="12" width="32" height="24" rx="6"/><circle cx="18" cy="24" r="3" fill="currentColor" stroke="none"/><circle cx="30" cy="24" r="3" fill="currentColor" stroke="none"/><path d="M24 4v8M16 44h16"/></svg>
              <span><%= diagram.left || 'Agente de IA' %></span>
            </div>
            <div class="lp__diagram-link">
              <svg viewBox="0 0 120 24" preserveAspectRatio="none" width="100%" height="24"><path d="M0 12h108" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6"/><path d="M104 5l8 7-8 7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
              <b><%= diagram.middle || 'MCP' %></b>
            </div>
            <div class="lp__diagram-node lp__diagram-node--api">
              <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 14l-8 10 8 10M30 14l8 10-8 10M27 10l-6 28"/></svg>
              <span><%= diagram.right || 'API' %></span>
            </div>
            <div class="lp__diagram-link">
              <svg viewBox="0 0 120 24" preserveAspectRatio="none" width="100%" height="24"><path d="M0 12h108" stroke="currentColor" stroke-width="2"/><path d="M104 5l8 7-8 7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            </div>
            <ul class="lp__diagram-data">
              <% (diagram.items || []).forEach(item => { %>
                <li><%= item %></li>
              <% }) %>
            </ul>
          </div>

          <div class="row">
            <% ai.features.forEach(item => { %>
              <div class="col-md-4 mb-4">
                <div class="lp__card lp__card--ai">
                  <h3 class="lp__card-title"><%= item.title %></h3>
                  <p class="lp__card-text"><%= item.text %></p>
                </div>
              </div>
            <% }) %>
          </div>

        </div>
      </section>
    <% } %>

    <%
    // seções de conversa animada: dados via MCP e edição visual
    const chatSections = [
      { key: 'data', data: chatData, reverse: false },
      { key: 'visual', data: chatVisual, reverse: true }
    ]
    for (const { key, data, reverse } of chatSections) {
      const chats = Array.isArray(data.chats) ? data.chats : []
      if (!chats.length) continue
      %>
      <section class="lp__section lp__convo lp__convo--<%= key %>">
        <div class="container">
          <div class="lp__convo-grid <%= reverse ? 'lp__convo-grid--reverse' : '' %>">
            <div class="lp__convo-text">
              <% if (data.eyebrow) { %>
                <span class="lp__eyebrow"><%= data.eyebrow %></span>
              <% } %>
              <h2 class="lp__convo-title"><%= data.title %></h2>
              <% if (data.subtitle) { %>
                <p class="lp__convo-subtitle"><%= data.subtitle %></p>
              <% } %>
              <% if (Array.isArray(data.bullets) && data.bullets.length) { %>
                <ul class="lp__convo-bullets">
                  <% data.bullets.forEach(b => { %>
                    <li><i class="i-check-circle"></i><%= b %></li>
                  <% }) %>
                </ul>
              <% } %>
            </div>

            <div class="lp__chat" data-chats="<%= JSON.stringify(chats) %>" aria-hidden="true">
              <div class="lp__chat-bar">
                <span></span><span></span><span></span>
                <em><%= data.chat_title || '' %></em>
              </div>
              <div class="lp__chat-stage">
                <div class="lp__chat-msg lp__chat-msg--user" data-chat-user><%= chats[0].question %></div>
                <div class="lp__chat-msg lp__chat-msg--ai" data-chat-ai>
                  <small><%= data.author || 'IA' %></small>
                  <span data-chat-answer><%= chats[0].answer %></span>
                </div>
                <div class="lp__chat-meta" data-chat-meta><%= chats[0].meta || '' %></div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <%
    }
    %>

    <% if (Array.isArray(spin.items) && spin.items.length) { %>
      <section class="lp__section lp__spin">
        <div class="container">
          <% if (spin.title) { %>
            <h2 class="lp__section-title"><%= spin.title %></h2>
          <% } %>
          <% if (spin.subtitle) { %>
            <p class="lp__section-subtitle"><%= spin.subtitle %></p>
          <% } %>
          <ol class="lp__spin-list">
            <% spin.items.forEach((item, i) => { %>
              <li class="lp__spin-item" <%= i === spin.items.length - 1 ? 'data-solution' : '' %>>
                <span class="lp__spin-label"><%= item.label %></span>
                <h3 class="lp__spin-title"><%= item.title %></h3>
                <p class="lp__spin-text"><%= item.text %></p>
              </li>
            <% }) %>
          </ol>
        </div>
      </section>
    <% } %>

    <% if (Array.isArray(comparison.rows) && comparison.rows.length) { %>
      <section class="lp__section lp__comparison">
        <div class="container">
          <% if (comparison.title) { %>
            <h2 class="lp__section-title"><%= comparison.title %></h2>
          <% } %>
          <% if (comparison.subtitle) { %>
            <p class="lp__section-subtitle"><%= comparison.subtitle %></p>
          <% } %>
          <% const cols = comparison.columns || ['e-com.plus', 'Outras plataformas'] %>
          <div class="lp__table-wrap">
            <table class="lp__table">
              <thead>
                <tr>
                  <th></th>
                  <th class="lp__table-plus"><%= cols[0] %></th>
                  <th><%= cols[1] %></th>
                </tr>
              </thead>
              <tbody>
                <% comparison.rows.forEach(row => { %>
                  <tr>
                    <th scope="row"><%= row.label %></th>
                    <td class="lp__table-plus">
                      <i class="i-check-circle"></i>
                      <span><%= row.plus %></span>
                    </td>
                    <td>
                      <i class="i-times-circle"></i>
                      <span><%= row.others %></span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <div class="text-center mt-4">
            <a href="#assinar" class="lp__btn lp__btn--primary lp__btn--lg" data-scroll-to="assinar">
              <%= hero.cta || 'Assinar agora' %>
              <i class="i-chevron-down ml-1"></i>
            </a>
          </div>
        </div>
      </section>
    <% } %>

    <% if (Array.isArray(benefits.items) && benefits.items.length) { %>
      <section class="lp__section lp__benefits">
        <div class="container">
          <% if (benefits.title) { %>
            <h2 class="lp__section-title"><%= benefits.title %></h2>
          <% } %>
          <div class="row">
            <% benefits.items.forEach(item => { %>
              <div class="col-md-6 col-lg-4 mb-4">
                <div class="lp__card">
                  <% if (item.icon) { %>
                    <span class="lp__card-icon">
                      <i class="i-<%= item.icon %>"></i>
                    </span>
                  <% } %>
                  <h3 class="lp__card-title"><%= item.title %></h3>
                  <p class="lp__card-text"><%= item.text %></p>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (Array.isArray(steps.items) && steps.items.length) { %>
      <section class="lp__section lp__steps">
        <div class="container">
          <% if (steps.title) { %>
            <h2 class="lp__section-title"><%= steps.title %></h2>
          <% } %>
          <ol class="lp__steps-list row">
            <% steps.items.forEach((step, i) => { %>
              <li class="col-md-4 mb-4">
                <span class="lp__step-number"><%= i + 1 %></span>
                <h3 class="lp__step-title"><%= step.title %></h3>
                <p class="lp__step-text"><%= step.text %></p>
              </li>
            <% }) %>
          </ol>
        </div>
      </section>
    <% } %>

    <section id="assinar" class="lp__section lp__checkout">
      <div class="container">
        <% if (checkout.title) { %>
          <h2 class="lp__section-title"><%= checkout.title %></h2>
        <% } %>
        <% if (checkout.subtitle) { %>
          <p class="lp__section-subtitle"><%= checkout.subtitle %></p>
        <% } %>
      </div>

      <% if (product) { %>
        <div class="lp__product">
          <%- await include('@/sections/product-block', { _: { ..._, state: product }, opt: {} }) %>
        </div>
      <% } else { %>
        <div class="container">
          <p class="lp__section-subtitle">Produto indisponível no momento. Fale com a gente pelos contatos do rodapé.</p>
        </div>
      <% } %>
    </section>

    <% if (Array.isArray(faq.items) && faq.items.length) { %>
      <section class="lp__section lp__faq">
        <div class="container">
          <% if (faq.title) { %>
            <h2 class="lp__section-title"><%= faq.title %></h2>
          <% } %>
          <div class="lp__faq-list">
            <% faq.items.forEach(item => { %>
              <details class="lp__faq-item">
                <summary class="lp__faq-question"><%= item.question %></summary>
                <p class="lp__faq-answer"><%= item.answer %></p>
              </details>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>
  </main>

  <footer class="lp__footer">
    <div class="container">
      <div class="lp__footer-row">
        <div class="lp__footer-contacts">
          <% if (contacts.whatsapp) { %>
            <a
              class="whatsapp-link"
              href="https://wa.me/<%= whatsapp.length <= 11 ? '55' + whatsapp : whatsapp %>"
              target="_blank"
              rel="noopener"
              data-tel="<%= whatsapp %>"
            >
              <i class="i-whatsapp mr-1"></i>
              <%= contacts.whatsapp %>
            </a>
          <% } %>
          <% if (contacts.email) { %>
            <a href="mailto:<%= contacts.email %>">
              <i class="i-envelope mr-1"></i>
              <%= contacts.email %>
            </a>
          <% } %>
        </div>
        <% if (Array.isArray(footer.links) && footer.links.length) { %>
          <nav class="lp__footer-links">
            <% footer.links.forEach(link => { %>
              <a href="<%= link.href %>" target="_blank" rel="noopener"><%= link.label %></a>
            <% }) %>
          </nav>
        <% } %>
      </div>
      <div class="lp__credits">
        <span><%= footer.credits || `© ${_.settings.name}` %></span>
        <%- await include('@/layout/inc/ecom-credits') %>
      </div>
    </div>
  </footer>

  <%
  // contexto de página de produto para o widget de compra (`storefront.context.body`);
  // montado aqui, depois de `@/head` preencher `_.widgets`
  const productContext = { ..._, resolveRoute: async () => (product ? { resource: 'products', body: product } : {}) }
  %>
  <%- await include('@/json', { _: productContext }) %>

  <script>
    /*<!--*/
    (function () {
      // conversas de exemplo: pergunta digitada, indicador e resposta palavra a palavra
      var setupChat = function ($chat) {
        var chats = []
        try { chats = JSON.parse($chat.getAttribute('data-chats')) } catch (e) {}
        var $user = $chat.querySelector('[data-chat-user]')
        var $ai = $chat.querySelector('[data-chat-ai]')
        var $answer = $chat.querySelector('[data-chat-answer]')
        var $meta = $chat.querySelector('[data-chat-meta]')
        if (!chats.length || !$user || !$ai || !$answer) return
        var index = 0
        var started = false
        var wait = function (ms) {
          return new Promise(function (resolve) { setTimeout(resolve, ms) })
        }
        var typeText = function ($el, text, msPerChar) {
          $el.textContent = ''
          $el.classList.add('is-typing')
          var i = 0
          return new Promise(function (resolve) {
            var tick = function () {
              i++
              $el.textContent = text.slice(0, i)
              if (i < text.length) {
                setTimeout(tick, msPerChar + Math.random() * 25)
              } else {
                $el.classList.remove('is-typing')
                resolve()
              }
            }
            tick()
          })
        }
        var streamWords = function ($el, text, msPerWord) {
          var words = text.split(' ')
          var i = 0
          $el.textContent = ''
          return new Promise(function (resolve) {
            var tick = function () {
              i++
              $el.textContent = words.slice(0, i).join(' ')
              if (i < words.length) {
                setTimeout(tick, msPerWord + Math.random() * 40)
              } else {
                resolve()
              }
            }
            tick()
          })
        }
        var play = function () {
          var chat = chats[index % chats.length]
          $ai.hidden = true
          $ai.classList.remove('is-thinking')
          $meta.hidden = true
          $meta.textContent = chat.meta || ''
          typeText($user, chat.question, 28)
            .then(function () { return wait(500) })
            .then(function () {
              $answer.textContent = ''
              $ai.hidden = false
              $ai.classList.add('is-thinking')
              return wait(1100)
            })
            .then(function () {
              $ai.classList.remove('is-thinking')
              return streamWords($answer, chat.answer, 55)
            })
            .then(function () {
              $meta.hidden = false
              return wait(6000)
            })
            .then(function () {
              index++
              play()
            })
        }
        var start = function () {
          if (started) return
          started = true
          play()
        }
        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function (entries) {
            if (entries.some(function (entry) { return entry.isIntersecting })) {
              observer.disconnect()
              start()
            }
          }, { threshold: .35 })
          observer.observe($chat)
        } else {
          start()
        }
      }
      Array.prototype.forEach.call(document.querySelectorAll('.lp__chat[data-chats]'), setupChat)
      // rolagem suave para as âncoras da página
      document.addEventListener('click', function (ev) {
        var $link = ev.target.closest && ev.target.closest('[data-scroll-to]')
        if ($link) {
          ev.preventDefault()
          var $el = document.getElementById($link.getAttribute('data-scroll-to'))
          if ($el) {
            $el.scrollIntoView({ behavior: 'smooth', block: 'start' })
          }
        }
      })
    }())
    /*-->*/
  </script>

  <%- await include('@/scripts') %>
</body>

</html>
